# Production secrets for app.config.ts — copy to ".env" (gitignored) and fill in,
# or set as EAS secrets (`eas secret:create`). NEVER commit real values.
# All are optional; without them the app uses Google TEST ads + RC placeholders.

ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
