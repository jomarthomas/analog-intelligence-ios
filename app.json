{
  "expo": {
    "name": "Analog Intelligence",
    "slug": "analog-intelligence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "analogintelligence",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.analogintelligence.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Analog Intelligence uses the camera to scan film negatives.",
        "NSPhotoLibraryUsageDescription": "Analog Intelligence can import negatives from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Analog Intelligence saves your scanned positives to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.analogintelligence.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Analog Intelligence uses the camera to scan film negatives.",
          "enableCodeScanner": false,
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Analog Intelligence can import negatives from your photo library.",
          "savePhotosPermission": "Analog Intelligence saves your scanned positives to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" }
        }
      ]
    ],
    "extra": {
      "revenueCatApiKeyIos": "appl_PLACEHOLDER_REVENUECAT_IOS_KEY",
      "revenueCatApiKeyAndroid": "goog_PLACEHOLDER_REVENUECAT_ANDROID_KEY",
      "revenueCatEntitlementId": "pro",
      "revenueCatOfferingId": "default",
      "admobBannerAdUnitIdIos": "ca-app-pub-3940256099942544/2934735716",
      "admobBannerAdUnitIdAndroid": "ca-app-pub-3940256099942544/6300978111"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
